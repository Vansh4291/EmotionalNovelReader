# Backend server port
BACKEND_PORT=3000

# API key for authentication (shared between backend and frontend)
API_KEY=dev-key-change-in-production

# Comma-separated list of allowed CORS origins
# Default when unset: http://localhost:3001,http://localhost:3000,http://10.0.2.2:3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3000,http://10.0.2.2:3000
